 const NON_VISION_USER_IMAGE_PLACEHOLDER = "(image omitted: model does not support images)";
 const NON_VISION_TOOL_IMAGE_PLACEHOLDER = "(tool image omitted: model does not support images)";
 const ERROR_TOOL_IMAGE_PLACEHOLDER = "(image attached after the tool results)";
+const LLM_THOUGHT_SIGNATURE_SEPARATOR = "__thought__";
+const OPENAI_TOOL_CALL_ID_LIMIT = 40;
+function stripLLMThoughtSignatureFromId(id) {
+    const separatorIndex = id.indexOf(LLM_THOUGHT_SIGNATURE_SEPARATOR);
+    return separatorIndex === -1 ? id : id.slice(0, separatorIndex);
+}
+function stripLLMThoughtSignaturesFromMessage(message, model, normalizeToolCallId, toolCallIdMap) {
+    const isSameModel = message.provider === model.provider &&
+        message.api === model.api &&
+        message.model === model.id;
+    let changed = false;
+    const content = message.content.map((block) => {
+        if (block.type !== "toolCall")
+            return block;
+        const shouldStrip = !isSameModel ||
+            (block.id.length === OPENAI_TOOL_CALL_ID_LIMIT &&
+                block.id.includes(LLM_THOUGHT_SIGNATURE_SEPARATOR));
+        if (!shouldStrip)
+            return block;
+        const unsignedId = stripLLMThoughtSignatureFromId(block.id);
+        const normalizedId = !isSameModel && normalizeToolCallId
+            ? normalizeToolCallId(unsignedId, model, message)
+            : unsignedId;
+        if (normalizedId === block.id && !block.thoughtSignature)
+            return block;
+        const normalizedToolCall = { ...block, id: normalizedId };
+        delete normalizedToolCall.thoughtSignature;
+        if (normalizedId !== block.id) {
+            toolCallIdMap.set(block.id, normalizedId);
+        }
+        changed = true;
+        return normalizedToolCall;
+    });
+    return changed ? { ...message, content } : message;
+}
