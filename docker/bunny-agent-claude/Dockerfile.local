# Bunny Agent image built from the local monorepo without publishing packages.
# Builds and deploys runner-cli and daemon with their production dependencies.
#
# Build from repo root (use .dockerignore at repo root to exclude node_modules, .git, etc.):
#   docker build -f docker/bunny-agent-claude/Dockerfile.local -t vikadata/bunny-agent:local .

# -----------------------------------------------------------------------------
# Stage 1: build and deploy local applications
# -----------------------------------------------------------------------------
FROM node:24-slim AS builder

WORKDIR /build

RUN corepack enable && corepack prepare pnpm@10.11.0 --activate && pnpm --version

# Copy full repo so pnpm workspace resolves (context = repo root)
COPY . .

# Build both application graphs. The daemon bundle only externalizes jiti, which
# is already present in runner-cli's production deployment, so keep one shared
# dependency tree instead of copying a second pnpm virtual store.
RUN pnpm install --frozen-lockfile && \
    pnpm --filter @bunny-agent/runner-cli... \
      --filter @bunny-agent/daemon... build && \
    pnpm --filter @bunny-agent/runner-cli --prod \
      deploy --legacy /deploy/runtime && \
    mkdir -p /deploy/runtime/daemon-dist && \
    cp -r /build/apps/daemon/dist/. /deploy/runtime/daemon-dist/ && \
    find /deploy/runtime/node_modules/.pnpm -type l \
      -lname '*linux*musl*' -delete && \
    find /deploy/runtime/node_modules/.pnpm -mindepth 1 -maxdepth 1 \
      -type d -name '*linux*musl*' -exec rm -rf {} +

# -----------------------------------------------------------------------------
# Stage 2: runtime image with local deploy artifacts
# -----------------------------------------------------------------------------
FROM node:24-slim

LABEL org.opencontainers.image.title="bunny-agent"
LABEL org.opencontainers.image.description="Bunny Agent with locally built runners"

RUN for i in 1 2 3; do \
    apt-get update && apt-get install -y --no-install-recommends \
      git curl python3 python3-pip \
      && rm -rf /var/lib/apt/lists/* && break || sleep 5; \
    done

RUN mkdir -p /workspace && chmod 777 /workspace
WORKDIR /workspace

# Playwright is shared by browser helpers outside the deployed applications.
RUN mkdir -p /opt/bunny-agent/node_modules && \
    cd /opt/bunny-agent && npm init -y && \
    npm install --no-audit --no-fund playwright && \
    rm package.json package-lock.json && npm cache clean --force

# Install Playwright Chromium browser and system dependencies.
# Refresh apt keys before Playwright's apt-get (buildx+QEMU amd64 on arm64 hosts).
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/bunny-agent/pw-browsers
RUN apt-get update && \
    apt-get install -y --no-install-recommends --reinstall \
      ca-certificates \
      debian-archive-keyring \
      gnupg \
    && rm -rf /var/lib/apt/lists/* \
    && cd /opt/bunny-agent \
    && DEBIAN_FRONTEND=noninteractive npx playwright install --with-deps --no-shell chromium

# Copy the shared production deployment, including externalized runtime modules.
RUN mkdir -p /opt/bunny-agent/node_modules/@bunny-agent
COPY --from=builder /deploy/runtime /opt/bunny-agent/node_modules/@bunny-agent/runner-cli

# Init script (copy deps to workspace when needed)
RUN echo '#!/bin/bash\n\
if [ ! -d "/workspace/node_modules/@bunny-agent" ]; then\n\
  echo "Copying bunny-agent dependencies to workspace..."\n\
  mkdir -p /workspace/node_modules\n\
  cp -r /opt/bunny-agent/node_modules/* /workspace/node_modules/\n\
fi\n\
exec "$@"' > /usr/local/bin/bunny-agent-init && \
    chmod +x /usr/local/bin/bunny-agent-init && \
    ln -s bunny-agent-init /usr/local/bin/sandagent-init

# Bunny Agent commands, with legacy SandAgent aliases.
RUN echo '#!/usr/bin/env node' > /usr/local/bin/bunny-agent && \
    echo 'import("/opt/bunny-agent/node_modules/@bunny-agent/runner-cli/dist/bundle.mjs")' >> /usr/local/bin/bunny-agent && \
    chmod +x /usr/local/bin/bunny-agent && \
    ln -s bunny-agent /usr/local/bin/sandagent
RUN echo '#!/usr/bin/env node' > /usr/local/bin/bunny-agent-daemon && \
    echo 'import("/opt/bunny-agent/node_modules/@bunny-agent/runner-cli/daemon-dist/bundle.mjs")' >> /usr/local/bin/bunny-agent-daemon && \
    chmod +x /usr/local/bin/bunny-agent-daemon && \
    ln -s bunny-agent-daemon /usr/local/bin/sandagent-daemon

# apply_patch: real shell command for OpenAI's V4A patch format (GPT-5.x
# Codex-harness habit).
RUN echo '#!/usr/bin/env node' > /usr/local/bin/apply_patch && \
    echo 'import("/opt/bunny-agent/node_modules/@bunny-agent/runner-cli/dist/apply-patch-bin.js")' >> /usr/local/bin/apply_patch && \
    chmod +x /usr/local/bin/apply_patch

# Install global CLI tools for agent use
RUN npm install -g brave-search-cli

# Entrypoint: copy /skills, start daemon + optional CDP, then exec CMD
RUN printf '%s\n' \
    '#!/bin/bash' \
    'mkdir -p "$HOME/.claude/skills"' \
    'if [ -d /skills ] && [ -n "$(ls -A /skills 2>/dev/null)" ]; then' \
    '  cp -r /skills/. "$HOME/.claude/skills/"' \
    '  echo "Copied /skills to $HOME/.claude/skills"' \
    'fi' \
    'bunny-agent-daemon &' \
    'case "${START_CDP_ON_INIT:-1}" in' \
    '  0) echo "CDP startup disabled by START_CDP_ON_INIT=0" ;;' \
    '  *) start-cdp ;;' \
    'esac' \
    'exec "$@"' > /usr/local/bin/bunny-agent-entrypoint && \
    chmod +x /usr/local/bin/bunny-agent-entrypoint && \
    ln -s bunny-agent-entrypoint /usr/local/bin/sandagent-entrypoint

ENV NODE_PATH=/opt/bunny-agent/node_modules
ENV PATH=/usr/local/bin:$PATH
ENV SANDAGENT_ROOT=/agent
ENV SANDAGENT_DAEMON_HOST=0.0.0.0
ENV SANDAGENT_DAEMON_PORT=3080
ENV START_CDP_ON_INIT=1

# Suppress D-Bus errors in headless Chromium (no bus in containers)
ENV DBUS_SESSION_BUS_ADDRESS=/dev/null

# Create CDP (Chrome DevTools Protocol) startup script
# Use nginx to proxy and rewrite Host header to localhost,
# bypassing Chromium's Host header security check
RUN for i in 1 2 3; do \
    apt-get update && apt-get install -y --no-install-recommends nginx && \
    rm -rf /var/lib/apt/lists/* && break || sleep 5; \
    done

RUN printf '%s\n' \
    'worker_processes auto;' \
    'pid /tmp/nginx/nginx.pid;' \
    'error_log /tmp/nginx/error.log;' \
    'events {}' \
    'http {' \
    '    access_log off;' \
    '    client_body_temp_path /tmp/nginx/client_body;' \
    '    proxy_temp_path /tmp/nginx/proxy;' \
    '    fastcgi_temp_path /tmp/nginx/fastcgi;' \
    '    uwsgi_temp_path /tmp/nginx/uwsgi;' \
    '    scgi_temp_path /tmp/nginx/scgi;' \
    '    include /etc/nginx/mime.types;' \
    '    default_type application/octet-stream;' \
    '    sendfile on;' \
    '    include /etc/nginx/conf.d/*.conf;' \
    '}' > /etc/nginx/nginx.conf && \
    echo 'server {\n\
    listen 9222;\n\
    location / {\n\
        proxy_pass http://127.0.0.1:9223;\n\
        proxy_set_header Host localhost;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
    }\n\
}' > /etc/nginx/conf.d/cdp-proxy.conf && \
    rm -f /etc/nginx/sites-enabled/default

RUN echo '#!/bin/bash\n\
set -e\n\
CHROME_BIN=$(node -e "console.log(require('"'"'playwright'"'"').chromium.executablePath())")\n\
"$CHROME_BIN" --headless --no-sandbox --disable-gpu --disable-dev-shm-usage --disable-software-rasterizer \\\n\
  --remote-debugging-port=9223 --remote-allow-origins=* 2>/dev/null &\n\
for i in $(seq 1 30); do\n\
  if curl -s http://127.0.0.1:9223/json/version > /dev/null 2>&1; then break; fi\n\
  sleep 0.5\n\
done\n\
mkdir -p /tmp/nginx/client_body /tmp/nginx/proxy /tmp/nginx/fastcgi /tmp/nginx/uwsgi /tmp/nginx/scgi\n\
nginx -t\n\
nginx\n\
echo "CDP available on 0.0.0.0:9222 (nginx proxy rewriting Host to localhost)"' > /usr/local/bin/start-cdp && \
    chmod +x /usr/local/bin/start-cdp

EXPOSE 3080
EXPOSE 9222

ENTRYPOINT ["/usr/local/bin/bunny-agent-entrypoint"]
CMD ["sleep", "infinity"]
